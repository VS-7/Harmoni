# ==============================================================================
# Harmoni - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# ==============================================================================

# Porta de ligação no host
PORT_BIND=8080

# Credenciais do PostgreSQL com pgvector
POSTGRES_DB=harmoni
POSTGRES_USER=harmoni
POSTGRES_PASSWORD=harmoni_secret

# Diretórios no host para persistência
MUSIC_DIR_HOST=./music
DATA_DIR_HOST=./data

# Ambiente de execução (development | production)
ENV=production
